{
  "name": "Issue certificate on quiz pass",
  "description": "Genererar och skickar automatiskt ett kursintyg (PDF + e-post) n\u00e4r en anv\u00e4ndare godk\u00e4nns p\u00e5 en moduls kunskapskontroll.",
  "trigger": {
    "condition": "${ (.trigger.data.passed == true) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "QuizResult"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "issue_certificate_on_quiz_pass",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "issueCertificate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "issueCertificate"
  }
}