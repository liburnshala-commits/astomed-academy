{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "description": "Purchased module ID"
    },
    "user_id": {
      "type": "string",
      "description": "Base44 user ID (if logged in at time of purchase)"
    },
    "buyer_email": {
      "type": "string",
      "description": "Buyer email"
    },
    "buyer_name": {
      "type": "string",
      "description": "Buyer name"
    },
    "amount": {
      "type": "number",
      "description": "Amount paid in SEK"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "refunded"
      ],
      "default": "pending"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID"
    }
  },
  "required": [
    "module_id",
    "buyer_email"
  ]
}